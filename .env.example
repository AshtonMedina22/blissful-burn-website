# Required when you are ready to accept real Stripe payments.
# Use sk_test_... while testing; switch to sk_live_... only when ready for live payments.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Stripe Checkout settings.
# Defaults to /cart?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL=http://localhost:3000/cart?checkout=success&session_id={CHECKOUT_SESSION_ID}
# Defaults to /cart?checkout=cancelled
STRIPE_CANCEL_URL=http://localhost:3000/cart?checkout=cancelled
# Comma-separated country codes. Defaults to US.
STRIPE_SHIPPING_COUNTRIES=US
# Set to false to disable promotion-code entry in Stripe Checkout.
STRIPE_ALLOW_PROMOTION_CODES=true
# Set to true only after configuring automatic tax in Stripe.
STRIPE_ENABLE_AUTOMATIC_TAX=false

# Not required for the current hosted Checkout flow, but safe to add later
# if you build client-side Stripe Elements or embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
